		sourceColumn: [Día Semana]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				VAR FechaMin = MIN(MIN('df_egresos_dia'[FECHA]), MIN('df_ingresos_dia'[FECHA]))
				VAR FechaMax = MAX(MAX('df_egresos_dia'[FECHA]), MAX('df_ingresos_dia'[FECHA]))
				RETURN
				ADDCOLUMNS (
				    CALENDAR(FechaMin, FechaMax),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "mmmm"),
				    "Número Mes", MONTH([Date]),
				    "Día", DAY([Date]),
				    "Día Semana", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = c32d21b4a39c46eab75b5cc060c48a31

