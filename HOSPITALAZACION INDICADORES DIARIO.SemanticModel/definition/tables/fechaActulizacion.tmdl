	partition fechaActulizacion = m
		mode: import
		source = ```
				let
				    // Obtiene la fecha y hora de la actualización actual
				    FechaActualizacion = DateTime.LocalNow(),
				    
				    // Extrae la fecha y le resta 1 día
				    FechaAyer = Date.AddDays(DateTime.Date(FechaActualizacion), -1)
				in
				    FechaAyer
				```

	annotation PBI_ResultType = Date

